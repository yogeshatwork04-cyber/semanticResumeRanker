# Database Configuration
# Default is SQLite file database. Set DATABASE_URL for PostgreSQL in docker or production.
DATABASE_URL=sqlite:///./resume_ranker.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_ranker

# Application Settings
APP_NAME=AI-Based Resume Matching & Ranking System
APP_VERSION=0.1.0
DEBUG=False

# NLP & Calibration Settings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
SPACY_MODEL_NAME=en_core_web_sm
SEMANTIC_MIN_COSINE=0.28
SEMANTIC_MAX_COSINE=0.78
LISTED_ONLY_CREDIT=0.5
SKILL_EMBED_THRESHOLD=0.75
PROJECT_FALLBACK_CAP=70.0
HARD_REQ_EXPERIENCE_RATIO_CAP=0.5

